# Build configuration for official builds. Committed so builds are reproducible.
# Override values locally in .env (ignored by Gradle builds, which pass --reproducible).

VALENCED_DISCORD_SERVER_URL=https://github.com/zoinkdoggie94/shrubcord/issues
VALENCED_SOURCE_REPOSITORY_URL=https://github.com/zoinkdoggie94/shrubcord
VALENCED_LICENSE_URL=https://raw.githubusercontent.com/zoinkdoggie94/shrubcord/main/LICENSE

# Required while any bundled plugin is a stub with a default source.
VALENCED_DEFAULT_PLUGIN_REPOSITORY_URL=https://community.valenced.app/index.json

# Optional
VALENCED_DONATE_URL=
